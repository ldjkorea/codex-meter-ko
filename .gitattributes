# Shell entry points must run on Linux and Git Bash on Windows.
*.sh text eol=lf
android/gradlew text eol=lf
*.bat text eol=crlf
# Historical fixtures are hash checked as raw bytes.
*.source -text
*.aar binary
*.jar binary
*.otf binary
*.ttf binary

# Preserve official license bytes and provenance hashes on Windows checkouts.
LICENSE -text
licenses/** -text
android/app/src/main/assets/licenses/** -text
android/wear/src/main/assets/licenses/** -text
